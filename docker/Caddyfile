# FrankenPHP's server for PryTax (builds.md §2). `php_server` without a `worker` keeps the classic
# mode: Laravel boots on every request. TLS is left to a proxy in front, so SERVER_NAME is a plain port (:8080).
{
	admin off
	frankenphp
}

{$SERVER_NAME::8080} {
	root * /app/public
	encode zstd br gzip
	php_server
}
