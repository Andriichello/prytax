# PryTax's settings for Docker (APP-BUILDS-PLAN.md, phase 1). On a server: copy it to .env. In a development checkout,
# whose .env is the local one: copy it to .env.docker, uncomment PRYTAX_ENV_FILE and add `--env-file .env.docker` to
# every `docker compose` command.
# PRYTAX_ENV_FILE=.env.docker

APP_NAME=PryTax
APP_ENV=production
APP_DEBUG=false
# Generate it once with `docker compose run --rm --no-deps app php artisan key:generate --show` (no key needed for
# that) and never change or lose it: it encrypts the tax IDs, IBANs and invoice snapshots.
APP_KEY=
# The address people open; the e-mails' links lead there
APP_URL=http://localhost:8080
# The port on the host
APP_PORT=8080

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

LOG_CHANNEL=stderr
LOG_LEVEL=info

# The database: pick one of the three.
# 1. MySQL in a container (`docker compose --profile mysql up`): the user is created on its first start.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=prytax
DB_USERNAME=prytax
DB_PASSWORD=change-me
# 2. An external MySQL 8.0.13+ (a cloud database, or the host's: DB_HOST=host.docker.internal); MariaDB isn't
#    supported. Leave out the profile, and set DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD, and the CA
#    for TLS if the server requires it:
# MYSQL_ATTR_SSL_CA=/app/storage/mysql-ca.pem
# 3. SQLite, for one host: the app, the worker and the scheduler share the file in the storage volume (in WAL mode),
#    which `migrate` creates on the first start. Leave out the profile.
# DB_CONNECTION=sqlite
# DB_DATABASE=/app/storage/database/prytax.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Behind a TLS proxy (https://...): true, so the session cookie is only sent over HTTPS
SESSION_SECURE_COOKIE=false
# Behind a TLS proxy: its address (or a comma-separated list, or * when it isn't known, as on cloud load balancers),
# so its X-Forwarded-* headers are trusted and the links are https
# TRUSTED_PROXIES=*

AUTH_MODEL=Core\Models\User

# Registering a new organization from the sign-in page: anyone who reaches the address could create one, so keep it
# off unless the server is meant for public sign-up. The first owner comes from `prytax:create-owner` instead.
PRYTAX_REGISTRATION=false

# The host and port people open, exactly as in APP_URL, or the SPA can't sign in
SANCTUM_STATEFUL_DOMAINS=localhost:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mails (password resets, invitations, backup reports): `log` writes them to the log; set SMTP to send them
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
